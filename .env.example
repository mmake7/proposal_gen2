# ── 필수 ────────────────────────────────────────────────
# Anthropic Claude API Key
ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# ── LLM (선택) ──────────────────────────────────────────
# 사용할 모델 ID (기본: 최신 Opus). 비용 절감 시 claude-sonnet-4-6 등으로 교체 가능
ANTHROPIC_MODEL=claude-opus-4-8

# ── Flask (선택) ────────────────────────────────────────
# development = 디버거/리로더 ON, production = OFF(기본·안전)
FLASK_ENV=production
SECRET_KEY=your-secret-key-change-in-production
PORT=5000
# `python app.py`로 직접 띄울 때 바인드 호스트 (기본 0.0.0.0)
HOST=0.0.0.0

# ── v2 (선택) ───────────────────────────────────────────
# 1로 설정 시 v2 분석 결과를 data/analyses/에 자동 저장
# (주의: 현재 웹 /api/parse 경로는 이 자동저장을 우회함 — CLI/스크립트에서만 동작)
V2_AUTO_SAVE=0

# 참고: .env 로드 후 .env.local 이 override(우선) 적용됨
